# ============================================
# Falcão Saúde Ocupacional — stack de produção (VPS único)
# Copie para `.env` na raiz do projeto e preencha antes de rodar:
#   docker compose -f docker-compose.prod.yml up -d --build
# ============================================

# --- Banco (Postgres) ---
POSTGRES_USER=falcao
# Gere uma senha forte e única — nunca reaproveite a do compose de dev.
# Ex.: openssl rand -base64 24
POSTGRES_PASSWORD=""
POSTGRES_DB=falcao

# --- API ---
# Ex.: openssl rand -base64 48
JWT_SECRET=""

# --- Domínios (DNS precisa apontar pro IP deste servidor antes do primeiro up) ---
DOMAIN_APP="app.falcao.com"
DOMAIN_API="api.falcao.com"

# --- Microsoft SSO (opcional — só preencha se for usar login com Microsoft) ---
AZURE_AD_TENANT_ID=""
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_REDIRECT_URI="https://api.falcao.com/api/auth/microsoft/callback"
