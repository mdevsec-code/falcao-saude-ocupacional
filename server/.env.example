# ============================================
# Falcão Saúde Ocupacional — API (server/.env)
# Copie para `.env` e preencha antes de rodar.
# ============================================

# String de conexão do PostgreSQL.
DATABASE_URL="postgresql://user:password@localhost:5432/falcao?schema=public"

# Segredo usado para assinar os tokens JWT — gere um valor aleatório longo,
# nunca reaproveite o exemplo abaixo. Ex.: `openssl rand -base64 48`
JWT_SECRET="troque-por-um-segredo-aleatorio-de-pelo-menos-32-caracteres"

# Porta em que a API escuta.
PORT=3000

# Origens autorizadas a chamar a API (CORS), separadas por vírgula.
# Em dev: a origem do Vite. Em prod: o domínio real do frontend.
CORS_ORIGIN="http://localhost:5173"

# Usados apenas por `npm run seed` — criam a conta administrativa inicial.
# Gere uma senha forte e única; troque-a no primeiro login.
SEED_ADMIN_EMAIL="admin@falcao.com"
SEED_ADMIN_PASSWORD="troque-por-uma-senha-forte-com-12+-caracteres"
