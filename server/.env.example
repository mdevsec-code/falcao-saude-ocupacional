# ============================================
# Falcão Saúde Ocupacional — API (server/.env)
# Copie para `.env` e preencha antes de rodar.
# ============================================

# String de conexão do PostgreSQL.
DATABASE_URL="postgresql://user:password@localhost:5432/falcao?schema=public"

# Segredo usado para assinar os tokens JWT — gere um valor aleatório longo,
# nunca reaproveite o exemplo abaixo. Ex.: `openssl rand -base64 48`
JWT_SECRET="troque-por-um-segredo-aleatorio-de-pelo-menos-32-caracteres"

# Porta em que a API escuta.
PORT=3000

# Origens autorizadas a chamar a API (CORS), separadas por vírgula.
# Em dev: a origem do Vite. Em prod: o domínio real do frontend.
CORS_ORIGIN="http://localhost:5173"

# Usados apenas por `npm run seed` — criam a conta administrativa inicial.
# Gere uma senha forte e única; troque-a no primeiro login.
SEED_ADMIN_EMAIL="admin@falcao.com"
SEED_ADMIN_PASSWORD="troque-por-uma-senha-forte-com-12+-caracteres"

# ============================================
# Login único com Microsoft (SSO / Azure AD) — opcional.
# Só é necessário se o botão "Entrar com Microsoft" for usado no login.
# Veja o passo a passo de criação do App Registration em docs/deployment.md.
# ============================================

# URL do frontend em produção — usada para redirecionar de volta após o
# login com a Microsoft (com ou sem sucesso).
FRONTEND_URL="https://app.falcao.com"

# ID do tenant (diretório) do Azure AD/Entra ID da empresa.
AZURE_AD_TENANT_ID=""

# ID do aplicativo (App Registration) criado no Azure AD.
AZURE_AD_CLIENT_ID=""

# Segredo do aplicativo ("Client secret") gerado no Azure AD.
AZURE_AD_CLIENT_SECRET=""

# URL de callback registrada no Azure AD — precisa ser exatamente
# `<URL pública da API>/api/auth/microsoft/callback`.
AZURE_AD_REDIRECT_URI="https://api.falcao.com/api/auth/microsoft/callback"
