# ============================================
# Falcão Saúde Ocupacional — Variáveis de ambiente (exemplo)
# Copie este arquivo para `.env.local` e ajuste conforme necessário.
# ============================================

# URL base da API. Em desenvolvimento, usamos a origem do Vite para que o
# MSW (Mock Service Worker) consiga interceptar as requisições.
VITE_API_URL=http://localhost:5173/api

# Habilita o MSW no browser. Use `true` em dev/staging, `false` em prod.
VITE_ENABLE_MSW=true

# Mostra o botão "Entrar com Microsoft" na tela de login. Só ative depois
# de configurar o App Registration no Azure AD e as variáveis AZURE_AD_*
# no backend (ver server/README.md).
VITE_ENABLE_MICROSOFT_SSO=false

# Locale padrão (deve existir em src/i18n/locales)
VITE_DEFAULT_LOCALE=pt-BR

# Nome da aplicação (sobrescreve o default em config/brand.ts)
VITE_APP_NAME=Falcão Saúde Ocupacional

# Sentry DSN (opcional, usado em produção)
# VITE_SENTRY_DSN=

# Nível de log em dev
VITE_LOG_LEVEL=info
